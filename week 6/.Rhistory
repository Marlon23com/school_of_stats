age_outliers <- df[df$Age < age_lower | df$Age > age_upper, ]
# Count outlier rows
num_income_outliers <- nrow(income_outliers)
num_age_outliers <- nrow(age_outliers)
# Calculate percentage
pct_income_outliers <- (num_income_outliers / total_rows) * 100
pct_age_outliers <- (num_age_outliers / total_rows) * 100
# Print results
cat("Outliers in Income make up", round(pct_income_outliers, 2), "% of the data.\n")
cat("Outliers in Age make up", round(pct_age_outliers, 2), "% of the data.\n")
