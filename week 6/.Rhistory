# First create a new column for outlier classification
df <- df %>%
mutate(outlier_type = case_when(
income_outlier == 1 & age_outlier == 1 ~ "Both",
income_outlier == 1 ~ "Income Only",
age_outlier == 1 ~ "Age Only",
TRUE ~ "None"
))
# Then create the plot
ggplot(df, aes(x = Age, y = Income)) +
geom_point(aes(color = outlier_type)) +
scale_color_manual(name = "Outlier Type",
values = c("Both" = "red", "Income Only" = "blue",
"Age Only" = "green", "None" = "gray")) +
geom_hline(yintercept = c(income_stats$LowerBound, income_stats$UpperBound),
linetype = "dashed", color = "blue") +
geom_vline(xintercept = c(age_stats$LowerBound, age_stats$UpperBound),
linetype = "dashed", color = "green") +
labs(title = "Relationship Between Age and Income Outliers",
subtitle = "Dashed lines show outlier boundaries",
x = "Age", y = "Income") +
theme_minimal() +
theme(legend.position = "bottom")
# For Income
income_sd_before <- sd(df$Income)
income_iqr_before <- IQR(df$Income)
# For Age
age_sd_before <- sd(df$Age)
age_iqr_before <- IQR(df$Age)
# For Income
income_sd_after <- sd(df_cleaned$Income)
income_iqr_after <- IQR(df_cleaned$Income)
# For Age
age_sd_after <- sd(df_cleaned$Age)
age_iqr_after <- IQR(df_cleaned$Age)
# Create comparison table
dispersion_comparison <- data.frame(
Variable = c("Income", "Income", "Age", "Age"),
Measure = c("Standard Deviation", "IQR", "Standard Deviation", "IQR"),
Before = c(income_sd_before, income_iqr_before, age_sd_before, age_iqr_before),
After = c(income_sd_after, income_iqr_after, age_sd_after, age_iqr_after),
Change = c(income_sd_before - income_sd_after,
income_iqr_before - income_iqr_after,
age_sd_before - age_sd_after,
age_iqr_before - age_iqr_after),
Pct_Change = c((income_sd_before - income_sd_after)/income_sd_before * 100,
(income_iqr_before - income_iqr_after)/income_iqr_before * 100,
(age_sd_before - age_sd_after)/age_sd_before * 100,
(age_iqr_before - age_iqr_after)/age_iqr_before * 100)
)
# Print formatted results
print("Comparison of Dispersion Measures Before and After Outlier Removal:")
dispersion_comparison %>%
mutate(across(where(is.numeric), ~ round(., 2))) %>%
knitr::kable()
# Reshape data for plotting
dispersion_long <- dispersion_comparison %>%
pivot_longer(cols = c(Before, After), names_to = "Condition", values_to = "Value")
# Load required packages
library(tidyr)  # For pivot_longer()
library(dplyr)  # For data manipulation
library(ggplot2) # For plotting
# Reshape data for plotting using pivot_longer
dispersion_long <- dispersion_comparison %>%
tidyr::pivot_longer(cols = c(Before, After),
names_to = "Condition",
values_to = "Value")
# Create plot
ggplot(dispersion_long, aes(x = Measure, y = Value, fill = Condition)) +
geom_bar(stat = "identity", position = "dodge") +
facet_wrap(~ Variable, scales = "free_y") +
labs(title = "Impact of Outliers on Measures of Dispersion",
subtitle = "Comparison of Standard Deviation vs IQR",
y = "Value", x = "Measure") +
scale_fill_brewer(palette = "Set1") +
theme_minimal() +
theme(legend.position = "bottom")
# Create age bins (adjust break points as needed)
age_breaks <- c(0, 20, 30, 40, 50, 60, 70, Inf)
age_labels <- c("0-20", "21-30", "31-40", "41-50", "51-60", "61-70", "70+")
df <- df %>%
mutate(age_group = cut(Age, breaks = age_breaks, labels = age_labels, include.lowest = TRUE))
# Count total records and outliers by age group
age_group_summary <- df %>%
group_by(age_group) %>%
summarize(
total_count = n(),
income_outliers = sum(income_outlier),
age_outliers = sum(age_outlier),
both_outliers = sum(income_outlier == 1 & age_outlier == 1),
any_outliers = sum(income_outlier == 1 | age_outlier == 1)
) %>%
mutate(
income_outlier_pct = income_outliers / total_count * 100,
age_outlier_pct = age_outliers / total_count * 100,
any_outlier_pct = any_outliers / total_count * 100
)
# View the summary
print("Outlier Counts by Age Group:")
age_group_summary %>%
mutate(across(where(is.numeric), ~ round(., 2)) %>%
knitr::kable()
# View the summary
print("Outlier Counts by Age Group:")
age_group_summary %>%
mutate(across(where(is.numeric), ~ round(., 2))) %>%
knitr::kable()
# Plot for income outliers
plot_income <- ggplot(age_group_summary, aes(x = age_group, y = income_outlier_pct)) +
geom_bar(stat = "identity", fill = "steelblue") +
labs(title = "Percentage of Income Outliers by Age Group",
x = "Age Group", y = "Percentage") +
theme_minimal()
# Plot for age outliers
plot_age <- ggplot(age_group_summary, aes(x = age_group, y = age_outlier_pct)) +
geom_bar(stat = "identity", fill = "salmon") +
labs(title = "Percentage of Age Outliers by Age Group",
x = "Age Group", y = "Percentage") +
theme_minimal()
# Plot for any outliers
plot_any <- ggplot(age_group_summary, aes(x = age_group, y = any_outlier_pct)) +
geom_bar(stat = "identity", fill = "purple") +
labs(title = "Percentage of Any Outliers by Age Group",
x = "Age Group", y = "Percentage") +
theme_minimal()
# Display plots
library(patchwork)
plot_income / plot_age / plot_any
# Chi-squared test for uniform distribution
chi_test_income <- chisq.test(age_group_summary$income_outliers)
chi_test_age <- chisq.test(age_group_summary$age_outliers)
# Print results
cat("\nChi-squared test for Income Outliers:\n")
print(chi_test_income)
cat("\nChi-squared test for Age Outliers:\n")
print(chi_test_age)
