# Function to compute IQR and outlier bounds
get_iqr_bounds <- function(column) {
q1 <- quantile(column, 0.25)
q3 <- quantile(column, 0.75)
iqr <- q3 - q1
lower_bound <- q1 - 1.5 * iqr
upper_bound <- q3 + 1.5 * iqr
list(Q1 = q1, Q3 = q3, IQR = iqr, LowerBound = lower_bound, UpperBound = upper_bound)
}
# Apply the function to Income and Age
income_stats <- get_iqr_bounds(df$Income)
age_stats <- get_iqr_bounds(df$Age)
# Print results
cat("Income:\n")
print(income_stats)
cat("\nAge:\n")
print(age_stats)
# Function to count outliers using IQR bounds
count_outliers <- function(column, iqr_bounds) {
lower <- iqr_bounds$LowerBound
upper <- iqr_bounds$UpperBound
# Count values below lower bound or above upper bound
outliers <- column[column < lower | column > upper]
return(list(
outlier_count = length(outliers),
outliers = outliers
))
}
# Apply for Income and Age
income_outliers <- count_outliers(df$Income, income_stats)
age_outliers <- count_outliers(df$Age, age_stats)
# Print results
cat("Outliers in Income:", income_outliers$outlier_count, "\n")
cat("Outliers in Age:", age_outliers$outlier_count, "\n")
# Identify outlier rows for Income and Age
